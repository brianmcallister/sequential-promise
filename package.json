{
  "name": "@brianmcallister/sequential-promise",
  "version": "2.0.0",
  "description": "Run promises that depend on each other, one after another",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmcallister/sequential-promise.git"
  },
  "homepage": "https://brianmcallister.github.io/sequential-promise/",
  "bugs": "https://github.com/brianmcallister/sequential-promise/issues",
  "license": "MIT",
  "author": {
    "name": "Brian Wm. McAllister",
    "email": "brian@brianmcallister.com",
    "url": "https://www.brianmcallister.com"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "promise",
    "sequential",
    "serial",
    "async",
    "allsettled",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "lint:package": "publint",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "publint": "0.3.15",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
